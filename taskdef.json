{
  "family": "",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "",
  "taskRoleArn": "",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "app",
      "image": "",
      "essential": true,
      "stopTimeout": 60,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q -O - http://127.0.0.1:8080/health >/dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        { "name": "SPRING_DATASOURCE_URL", "value": "" },
        { "name": "SPRING_DATA_REDIS_HOST", "value": "" },
        { "name": "SPRING_DATA_REDIS_PORT", "value": "" },
        { "name": "SPRING_DATA_REDIS_SSL_ENABLED", "value": "true" },
        { "name": "APP_CACHE_ENABLED", "value": "true" },
        { "name": "APP_CACHE_TTL_SECONDS", "value": "30" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "username::" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "password::" },
        { "name": "SPRING_DATA_REDIS_PASSWORD", "valueFrom": "token::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "",
          "awslogs-region": "",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
